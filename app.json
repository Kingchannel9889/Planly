{
  "expo": {
    "name": "Planly",
    "slug": "TOPP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/planly-icon.png",
    "scheme": "topp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.topp.planly"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/planly-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.topp.planly"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/planly-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F9FF",
          "image": "./assets/images/planly-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0878FF",
          "defaultChannel": "planner"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5029008f-3f96-404e-9d18-85d666799d7b"
      }
    }
  }
}
